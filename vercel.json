{
  "regions": ["bom1"],
  "functions": {
    "api/attendance.js": {
      "maxDuration": 60
    },
    "api/result.js": {
      "maxDuration": 60
    },
    "api/consolidated-result.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/google",
      "destination": "https://gpthyd-website.onrender.com/api/auth/google"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "https://gpthyd-website.onrender.com/api/auth/google/callback"
    },
    {
      "source": "/((?!api/|assets/|images/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
