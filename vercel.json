{
  "regions": ["bom1"],
  "functions": {
    "api/attendance.js": {
      "maxDuration": 60
    },
    "api/result.js": {
      "maxDuration": 60
    },
    "api/consolidated-result.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://gpthyd-website.onrender.com/api/auth/:path*"
    },
    {
      "source": "/((?!api/|assets/|images/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
