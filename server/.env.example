DB_HOST=your-tidb-serverless-host
DB_PORT=4000
DB_USER=your-tidb-user
DB_PASSWORD=your-tidb-password
DB_NAME=your-database-name

SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-domain.example
FRONTEND_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Cloudinary server-side configuration. Never expose the API secret to Vite.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_IMAGE_UPLOAD_PRESET=college_image_signed
CLOUDINARY_VIDEO_UPLOAD_PRESET=college_video_signed
CLOUDINARY_RAW_UPLOAD_PRESET=college_raw_signed
CLOUDINARY_WEBHOOK_URL=https://your-domain.example/api/media/cloudinary/webhook
CLOUDINARY_MAX_FILE_BYTES=2147483648
CLOUDINARY_CONTENT_MAX_FILE_BYTES=15728640

# Optional. Incoming transforms change the stored original; configure account backups first.
CLOUDINARY_BACKUP_ENABLED=false
CLOUDINARY_INCOMING_TRANSFORMATION=
