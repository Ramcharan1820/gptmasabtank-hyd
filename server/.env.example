SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://gptmasabtank.in
FRONTEND_ORIGINS=https://gptmasabtank.in,https://gptmasabtank-hyd.vercel.app,http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Brevo transactional email for alumni confirmations and admin password resets.
# Store the API key only in server-side environment variables.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Government Polytechnic College

# Cloudinary server-side configuration. Never expose the API secret to Vite.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_IMAGE_UPLOAD_PRESET=college_image_signed
CLOUDINARY_VIDEO_UPLOAD_PRESET=college_video_signed
CLOUDINARY_RAW_UPLOAD_PRESET=college_raw_signed
CLOUDINARY_WEBHOOK_URL=https://your-domain.example/api/media/cloudinary/webhook
CLOUDINARY_MAX_FILE_BYTES=2147483648
CLOUDINARY_CONTENT_MAX_FILE_BYTES=307200

# Optional. Incoming transforms change the stored original; configure account backups first.
CLOUDINARY_BACKUP_ENABLED=false
CLOUDINARY_INCOMING_TRANSFORMATION=
